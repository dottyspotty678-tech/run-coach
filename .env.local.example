NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (Supabase Project Settings -> API -> service_role secret).
# Used server-side only for all data-table access; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Stable canonical URL for this deployment — used to build OAuth redirect URIs.
# Must match the domain registered with Strava/Microsoft, NOT a per-deployment preview URL.
APP_URL=

ANTHROPIC_API_KEY=

# Random secret shared with Vercel Cron (sent as "Authorization: Bearer <value>").
CRON_SECRET=
